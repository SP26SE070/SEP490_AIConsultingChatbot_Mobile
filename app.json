      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.SEP490_AIConsultingChatbot_Mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-document-picker"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e1d71d24-42d1-493e-8049-ad00f885500e"
      }
    },
    "owner": "dt.2401"
